<Project Sdk="Microsoft.NET.Sdk">
  <!-- NuGet Package authoring best practices:
    https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->
  <PropertyGroup>
    <RootNamespace>Asphalt.Widgets</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Asphalt.Core/Asphalt.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Asphalt.Widgets.Tests" />
  </ItemGroup>
  <PropertyGroup Label="Package Metadata">
    <PackageId>Asphalt.Widgets</PackageId>
    <!-- <Description></Description> -->
    <!-- <PackageReleaseNotes></PackageReleaseNotes> -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- <PackageProjectUrl></PackageProjectUrl> -->
    <!-- <RepositoryUrl></RepositoryUrl> -->
    <RepositoryType>git</RepositoryType>
    <!-- <PackageTags></PackageTags> -->
    <!-- <PackageIcon></PackageIcon> -->
  </PropertyGroup>
  <PropertyGroup Label="Versioning">
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup Label="Versioning">
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
  <PropertyGroup Label="Licensing">
    <Authors>Logan Bussell</Authors>
    <Copyright>Copyright (c) 2026 $(Authors)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup Label="Package Content">
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
