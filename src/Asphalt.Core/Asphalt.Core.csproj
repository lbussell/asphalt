<Project Sdk="Microsoft.NET.Sdk">
  <!-- NuGet Package authoring best practices:
    https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->
  <PropertyGroup>
    <RootNamespace>Asphalt</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built-in widgets package uses internal RegisterFocusable / WidgetInputState. -->
    <InternalsVisibleTo Include="Asphalt.Widgets" />
    <InternalsVisibleTo Include="Asphalt.Core.Tests" />
    <!-- Integration tests in Asphalt.Widgets.Tests touch core internals (RegisterFocusable, GetCell). -->
    <InternalsVisibleTo Include="Asphalt.Widgets.Tests" />
  </ItemGroup>
  <PropertyGroup Label="Package Metadata">
    <PackageId>Asphalt.Core</PackageId>
    <!-- <Description></Description> -->
    <!-- <PackageReleaseNotes></PackageReleaseNotes> -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- <PackageProjectUrl></PackageProjectUrl> -->
    <!-- <RepositoryUrl></RepositoryUrl> -->
    <RepositoryType>git</RepositoryType>
    <!-- Add tags to help users find your package in search results.
      This should be a semicolon-delimited list of tags. -->
    <!-- <PackageTags></PackageTags> -->
    <!-- Use a 128x128 PNG with transparent background. -->
    <!-- <PackageIcon></PackageIcon> -->
  </PropertyGroup>
  <PropertyGroup Label="Versioning">
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup Label="Versioning">
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
  <PropertyGroup Label="Licensing">
    <Authors>Logan Bussell</Authors>
    <Copyright>Copyright (c) 2026 $(Authors)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup Label="Package Content">
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
